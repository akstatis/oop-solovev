<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <!-- System.Drawing нужен фигурам для Draw(Graphics); WinForms здесь не используется. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PaintApp.Core</RootNamespace>
    <AssemblyName>PaintApp.Core</AssemblyName>
  </PropertyGroup>

</Project>
